# Copy to .env.local for local dev (`npx vercel dev`), and set the same values in
# Vercel → Project → Settings → Environment Variables.

# --- Login ---
# Password you type on the login screen.
DASHBOARD_PASSWORD=
# Random secret used as the bearer token. Generate with: openssl rand -hex 32
DASHBOARD_SESSION_SECRET=

# --- Supabase ---
SUPABASE_URL=
# service_role key (SECRET — server only)
SUPABASE_SERVICE_ROLE_KEY=

# --- Enable Banking ---
# Application ID from the Enable Banking control panel (= the key id / kid)
ENABLEBANKING_APP_ID=
# Contents of the private key .pem, newlines as \n (one line)
ENABLEBANKING_PRIVATE_KEY=

# Public URL of this deployment, without trailing slash, e.g. https://finanzen.websbybenny.de
# The redirect URL registered at Enable Banking must be APP_URL + /api/callback
APP_URL=

# --- Daily sync cron (vercel.json) ---
# Generate with: openssl rand -hex 32
CRON_SECRET=
