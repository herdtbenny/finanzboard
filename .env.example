# Copy to .env.local for local dev (`npm run dev`), and set the same values in
# Vercel → Project → Settings → Environment Variables.

# --- Login ---
# Signs the session tokens. People and their passwords live in the database
# (scripts/setup-admin.js, then the admin screen). Generate with: openssl rand -hex 32
DASHBOARD_SESSION_SECRET=

# --- Supabase ---
SUPABASE_URL=
# service_role key (SECRET — server only)
SUPABASE_SERVICE_ROLE_KEY=

# --- Daily keep-alive cron (vercel.json) ---
# Generate with: openssl rand -hex 32
CRON_SECRET=
